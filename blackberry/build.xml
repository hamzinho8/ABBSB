<?xml version="1.0" encoding="UTF-8"?>
<project name="BBSmartBridge" default="build" basedir=".">
    <property environment="env"/>
    
    <property name="jde.home" value="${env.BLACKBERRY_JDE_HOME}"/>
    
    <target name="check-env">
        <fail message="BLACKBERRY_JDE_HOME is not set. Please set it to your JDE installation path." unless="env.BLACKBERRY_JDE_HOME"/>
    </target>

    <target name="generate-rapc">
        <echo file="BBSmartBridge.rapc">MIDlet-Name: SmartBridge
MIDlet-Version: 1.0.6
MIDlet-Vendor: Hamza
MIDlet-Description: Android Bluetooth Companion for BlackBerry
MIDlet-Jar-URL: BBSmartBridge.jar
MIDlet-Jar-Size: 0
MicroEdition-Profile: MIDP-2.0
MicroEdition-Configuration: CLDC-1.1
MIDlet-1: SmartBridge,icon.png,com.hamza.blackberrybridge.SmartBridgeApp
RIM-MIDlet-Flags-1: 0
RIM-MIDlet-Position-1: 0</echo>
    </target>
    
    <target name="generate-alx">
        <echo file="BBSmartBridge.alx">&lt;loader version="1.0"&gt;
    &lt;application id="BBSmartBridge"&gt;
        &lt;name&gt;SmartBridge&lt;/name&gt;
        &lt;description&gt;Android Bluetooth Companion for BlackBerry&lt;/description&gt;
        &lt;version&gt;1.0.6&lt;/version&gt;
        &lt;vendor&gt;Hamza&lt;/vendor&gt;
        &lt;copyright&gt;Copyright (c) 2024 Hamza&lt;/copyright&gt;
        &lt;fileset Java="1.54" _blackberryVersion="[5.0.0)"&gt;
            &lt;directory&gt;&lt;/directory&gt;
            &lt;files&gt;BBSmartBridge.cod&lt;/files&gt;
        &lt;/fileset&gt;
    &lt;/application&gt;
&lt;/loader&gt;</echo>
    </target>

    <target name="check-cod">
        <condition property="cod.is.valid">
            <and>
                <available file="BBSmartBridge.cod"/>
                <length file="BBSmartBridge.cod" when="greater" length="10000"/>
            </and>
        </condition>
    </target>

    <!-- Strategy 1: Compile classes with javac into BBSmartBridge.jar then RAPC via rapc.exe -->
    <target name="compile-classes" depends="check-env">
        <echo message="[Strategy 1] Compiling Java classes with javac (target 1.4/1.5)..."/>
        <delete dir="build/classes" quiet="true"/>
        <mkdir dir="build/classes"/>
        <javac srcdir="src" destdir="build/classes" source="1.4" target="1.4" bootclasspath="${jde.home}/lib/net_rim_api.jar" includeantruntime="false" debug="true" encoding="UTF-8"/>
        <!-- Copy icon to root of classes and res/ folder -->
        <copy file="icon.png" todir="build/classes" overwrite="true"/>
        <mkdir dir="build/classes/res"/>
        <copy file="icon.png" todir="build/classes/res" overwrite="true"/>
    </target>

    <target name="package-jar" depends="compile-classes, generate-rapc, generate-alx">
        <echo message="[Strategy 1] Packaging BBSmartBridge.jar with compiled classes and icon.png..."/>
        <delete file="BBSmartBridge.jar" quiet="true"/>
        <jar destfile="BBSmartBridge.jar" basedir="build/classes">
            <manifest>
                <attribute name="MIDlet-Name" value="SmartBridge"/>
                <attribute name="MIDlet-Version" value="1.0.6"/>
                <attribute name="MIDlet-Vendor" value="Hamza"/>
                <attribute name="MIDlet-1" value="SmartBridge,icon.png,com.hamza.blackberrybridge.SmartBridgeApp"/>
                <attribute name="MicroEdition-Profile" value="MIDP-2.0"/>
                <attribute name="MicroEdition-Configuration" value="CLDC-1.1"/>
            </manifest>
        </jar>
    </target>

    <target name="build-from-jar-exe" depends="package-jar, check-cod" unless="cod.is.valid">
        <echo message="[Strategy 1] Compiling BBSmartBridge.jar via rapc.exe..."/>
        <exec executable="${jde.home}/bin/rapc.exe" failonerror="false">
            <arg value="import=${jde.home}/lib/net_rim_api.jar"/>
            <arg value="codename=BBSmartBridge"/>
            <arg value="BBSmartBridge.rapc"/>
            <arg value="BBSmartBridge.jar"/>
        </exec>
    </target>

    <!-- Strategy 2: Compile classes to JAR then RAPC via java -jar rapc.jar -->
    <target name="build-from-jar-fallback" depends="package-jar, check-cod" unless="cod.is.valid">
        <echo message="[Strategy 2] Compiling BBSmartBridge.jar via java -jar rapc.jar..."/>
        <java jar="${jde.home}/bin/rapc.jar" fork="true" failonerror="false">
            <arg value="import=${jde.home}/lib/net_rim_api.jar"/>
            <arg value="codename=BBSmartBridge"/>
            <arg value="BBSmartBridge.rapc"/>
            <arg value="BBSmartBridge.jar"/>
        </java>
    </target>

    <!-- Strategy 3: Direct RAPC with source java files list -->
    <target name="build-direct-sources" depends="generate-rapc, generate-alx, check-cod" unless="cod.is.valid">
        <echo message="[Strategy 3] Compiling directly from .java source files via rapc.exe..."/>
        <path id="src.files">
            <fileset dir="." includes="src/**/*.java"/>
            <fileset dir="." includes="icon.png"/>
        </path>
        <pathconvert property="source.list" refid="src.files" pathsep=" "/>
        <exec executable="${jde.home}/bin/rapc.exe" failonerror="false">
            <arg value="import=${jde.home}/lib/net_rim_api.jar"/>
            <arg value="codename=BBSmartBridge"/>
            <arg value="BBSmartBridge.rapc"/>
            <arg line="${source.list}"/>
        </exec>
    </target>

    <target name="build" depends="check-env, generate-alx, generate-rapc">
        <echo message="Building BBSmartBridge using BlackBerry JDE at: ${jde.home}"/>
        
        <antcall target="build-from-jar-exe"/>
        <antcall target="build-from-jar-fallback"/>
        <antcall target="build-direct-sources"/>

        <fail message="BUILD FAILED: BBSmartBridge.cod was not created!">
            <condition>
                <not>
                    <available file="BBSmartBridge.cod"/>
                </not>
            </condition>
        </fail>
        
        <fail message="BUILD FAILED: BBSmartBridge.cod is too small (&lt; 10 KB). Classes were not compiled into the COD!">
            <condition>
                <length file="BBSmartBridge.cod" when="less" length="10000"/>
            </condition>
        </fail>
        
        <echo message="====================================================="/>
        <echo message="BUILD SUCCESSFUL: Valid BBSmartBridge.cod and BBSmartBridge.jad are ready!"/>
        <echo message="Application: SmartBridge v1.0.6 (Hamza) with custom icon"/>
        <echo message="====================================================="/>
    </target>

    <target name="clean">
        <delete dir="build"/>
        <delete>
            <fileset dir="." includes="*.cod,*.jad,*.cso,*.debug,*.jar,*.rapc,*.alx"/>
        </delete>
    </target>
</project>
